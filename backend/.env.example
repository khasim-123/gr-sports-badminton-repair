# Copy to backend/.env for local development. Never commit the real .env.

# development | production  (production enforces SECRET_KEY, hides /docs, requires explicit CORS origins)
ENVIRONMENT=development

# Local default is SQLite. For Postgres: postgresql+psycopg2://user:password@localhost:5432/badminton_db
DATABASE_URL=sqlite:///./badminton.db

# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# First admin login: mobile number + password (created on startup if missing; sets the
# password only if that admin has none yet)
ADMIN_PHONE=9876543210
ADMIN_PASSWORD=change-me-please

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public base URL of this API, used for links to uploaded images (optional locally)
PUBLIC_API_URL=

# Customer login codes are sent by SMS through MSG91 (needs DLT registration + an approved OTP template)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# auto | true | false — return login codes in the API response (see app/config.py).
# "auto" (the local default) shows the code on screen when no SMS could be sent.
EXPOSE_OTP_IN_RESPONSE=auto

# Load demo staff / sample requests (development only)
SEED_DEMO_DATA=true
