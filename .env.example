# ShuttleCraft Badminton Platform - Environment Variables
# Point this to your backend server once built (e.g., http://localhost:5000/api or http://localhost:8080/api)
VITE_API_BASE_URL=http://localhost:5000/api

# Set to true to use offline mock/localStorage data; set to false to connect to your real backend APIs
VITE_USE_MOCK_API=true
